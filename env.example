# =============================================================================
# Odisha Disaster Management RAG Platform — Environment Configuration
# =============================================================================
# NEVER commit this file to version control.
# Add .env to your .gitignore.
# =============================================================================


# ── Anthropic ─────────────────────────────────────────────────────────────────
# Used by: agent-runner.js, triage-agent.js, context-distiller.js, crag-critic.js

ANTHROPIC_API_KEY=your-new-anthropic-key-here


# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by: searchUtils.js (embeddings — always required)
#          query-rewriter.js (when REWRITER_PROVIDER=openai)

OPENAI_API_KEY=your-new-openai-key-here
OPENAI_AGENTS_DISABLE_TRACING=true


# ── Claude model selection ────────────────────────────────────────────────────
# LLM_MODEL    → specialist agents (Sonnet — deep reasoning + tool use)
# TRIAGE_MODEL → triage classifier + context distiller (Haiku — cheap + fast)

LLM_MODEL=claude-sonnet-4-6
TRIAGE_MODEL=claude-haiku-4-5


# ── Query Rewriter ────────────────────────────────────────────────────────────
# REWRITER_PROVIDER=openai  → gpt-4o-mini via OpenAI API (requires OPENAI_API_KEY)
# REWRITER_PROVIDER=ollama  → local model via Ollama (free, requires Ollama running)

REWRITER_PROVIDER=openai
REWRITER_OPENAI_MODEL=gpt-4o-mini

# Ollama — only needed when REWRITER_PROVIDER=ollama
# Pull first:  ollama pull mistral:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b


# ── Qdrant ────────────────────────────────────────────────────────────────────
# Used by: searchUtils.js → vectorSearch()
# Local Docker: leave QDRANT_API_KEY empty
# Qdrant Cloud: set QDRANT_API_KEY and update QDRANT_HOST to your cluster URL

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sdmp_chunks


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by: searchUtils.js → sqlSearch(), listTables(), describeTable()

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONN_TIMEOUT_MS=5000


# ── Server ────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development


# ── Data paths ────────────────────────────────────────────────────────────────

CSV_DIR=./public/Puri_DDMP/tables
SDMP_CLEANED=
LOCAL_BULLETINS_DIR=/Users/harshalrawal/Downloads


# ── Weather ───────────────────────────────────────────────────────────────────

OWM_API_KEY=98680316256ddfab8b5a09911fb9e90e
